# Minimal bisect image: same registry, same handler, none of the heavy layers.
# If this works on serverless while the full image times out, the fat layers are the
# problem; if this ALSO times out, ghcr-on-serverless is the problem.
FROM python:3.11-slim-bookworm
ENV PIP_NO_CACHE_DIR=1
RUN pip install "runpod>=1.8"
COPY handler.py /app/handler.py
WORKDIR /app
CMD python3 -u /app/handler.py > /tmp/b.log 2>&1; ec=$?; echo "EXIT_CODE=$ec" >> /tmp/b.log; python3 -c "import urllib.request as u; u.urlopen(u.Request('https://zx76ho79xfn5v5-8888.proxy.runpod.net/log', data=open('/tmp/b.log','rb').read()), timeout=25)" || true; sleep 3; exit $ec
