# Minimal bisect image: same registry, same handler, none of the heavy layers.
# If this works on serverless while the full image times out, the fat layers are the
# problem; if this ALSO times out, ghcr-on-serverless is the problem.
FROM python:3.11-slim-bookworm
ENV PIP_NO_CACHE_DIR=1
RUN pip install "runpod>=1.8"
COPY handler.py /app/handler.py
WORKDIR /app
CMD ["python3", "-u", "/app/handler.py"]
