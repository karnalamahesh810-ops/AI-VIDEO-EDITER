,72.3],["up",72.3,72.48],["onto",72.48,72.7],["the",72.7,72.9],["gates",72.9,73.06],["and",73.06,73.34],["bolted",73.34,73.82],["on",73.82,74],["extra",74,74.34],["height.",74.34,74.62],["Four",75.22,75.62],["-foot",75.62,75.94],["sheets",75.94,76.24],["of",76.24,76.62],["plywood.",76.62,76.86],["Plywood,",77.54,78.06],["holding",78.3,78.64]]},{"id":"s0017","startFrame":2359,"durationInFrames":244,"text":"back the second largest reservoir in the United States. What nobody set out loud, at least not publicly, was the real fear.","media":"image","subject":"Bureau of Reclamation engineers at Glen Canyon Dam","subjectType":"event","words":[["back",78.64,78.86],["the",78.86,79.08],["second",79.08,79.42],["largest",79.42,79.74],["reservoir",79.74,80.22],["in",80.22,80.52],["the",80.52,80.64],["United",80.64,80.88],["States.",80.88,81.48],["What",82.04,82.3],["nobody",82.3,82.68],["set",82.68,82.92],["out",82.92,83.1],["loud,",83.1,83.5],["at",83.72,83.8],["least",83.8,83.94],["not",83.94,84.16],["publicly,",84.16,84.7],["was",85.12,85.24],["the",85.24,85.42],["real",85.42,85.78],["fear.",85.78,86.2]]},{"id":"s0018","startFrame":2603,"durationInFrames":78,"text":"If that damage kept eating into the rock,","media":"video","subject":"Glen Canyon Dam spillway tunnel damage (1983)","subjectType":"event","words":[["If",86.78,86.96],["that",86.96,87.12],["damage",87.12,87.52],["kept",87.52,87.86],["eating",87.86,88.2],["into",88.2,88.52],["the",88.52,88.66],["rock,",88.66,88.86]]},{"id":"s0019","startFrame":2681,"durationInFrames":207,"text":"it could reach the old tunnels at the base of the dam. And if it did, the lake could start draining out from underneath.","media":"image","subject":"Glen Canyon Dam outlet/old tunnel system","subjectType":"object","words":[["it",89.36,89.46],["could",89.46,89.6],["reach",89.6,89.84],["the",89.84,90.08],["old",90.08,90.34],["tunnels",90.34,90.64],["at",90.64,90.94],["the",90.94,91.06],["base",91.06,91.28],["of",91.28,91.46],["the",91.46,91.5